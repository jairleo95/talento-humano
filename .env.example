# ============================================================
# Talento Humano — Variables de entorno requeridas
# Copia este archivo a .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- JWT (obligatorio, debe ser un secreto fuerte aleatorio) ---
# Generar con: openssl rand -hex 32
JWT_SECRET=

# --- Credenciales iniciales de usuarios seed (generar con python3 bcrypt) ---
# python3 -c "import bcrypt;print(bcrypt.hashpw(b'TU_PASSWORD',bcrypt.gensalt(12)).decode())"
ADMIN_INITIAL_PASSWORD_HASH=
USER_INITIAL_PASSWORD_HASH=

# --- PostgreSQL (obligatorio para identity/recruitment/contract) ---
DB_PASSWORD=
# Opcionales (con defaults de desarrollo):
# DB_URL=r2dbc:postgresql://localhost:5434/identity_db
# DB_JDBC_URL=jdbc:postgresql://localhost:5434/identity_db
# DB_USERNAME=identity_user

# --- Docker Compose (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Config Server ---
CONFIG_SERVER_PASSWORD=

# --- gth-ms (Oracle / WebServices) ---
GTH_ORACLE_HOST=
GTH_ORACLE_USER=
GTH_ORACLE_PASSWORD=
GTH_ORACLE_PORT=1521
GTH_ORACLE_SID=xe
GTH_WS_KEYAPP=
GTH_WS_KEYID=
GTH_WS_SERVER_URI=https://webapp.upeu.edu.pe/
GTH_WS_SERVICE_URI=https://webapp.upeu.edu.pe/webservices/wsdl4rrhh/
GTH_MYSQL_DB=bd_almacen
GTH_MYSQL_USER=
GTH_MYSQL_PASSWORD=
# Secreto para cifrado de IDs (AES)
GTH_CRYPTO_SECRET=
